  "lineHeight": {
    "display": "1.12",
    "heading": "1.25",
    "body": "1.6",
    "code": "1.55"
  },
  "letterSpacing": {
    "display": "-0.025em",
    "heading": "-0.01em",
    "caps": "0.08em"
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "layout": {
    "container": "1200px",
    "prose": "72ch",
    "sidebar": "280px",
    "gutter": "1rem"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "shadow": {
    "$note": "rgb(var(--z-shadow-rgb) / a) so each theme tints its own shadows.",
    "sm": "0 1px 2px rgb(var(--z-shadow-rgb) / 0.18)",
    "md": "0 4px 12px rgb(var(--z-shadow-rgb) / 0.22), 0 1px 3px rgb(var(--z-shadow-rgb) / 0.12)",
    "lg": "0 16px 40px rgb(var(--z-shadow-rgb) / 0.28), 0 2px 6px rgb(var(--z-shadow-rgb) / 0.14)"
  },
  "button": {
    "$note": "The family's raised 'physical' CTA: a hard, unblurred edge under the face. Hover lifts the face and deepens the edge, active presses it down. Reduced motion keeps the colours and drops the movement.",
    "depth": "4px",
    "depth-hover": "6px",
    "depth-active": "1px",
    "padding-y": "0.75rem",
    "padding-x": "1.375rem",
    "radius": "{radius.md}",
    "font-weight": "{fontWeight.semibold}",
    "padding-y-sm": "0.5rem",
    "padding-x-sm": "0.875rem",
    "font-size-sm": "{fontSize.sm}",
    "padding-y-lg": "0.9375rem",
    "padding-x-lg": "1.75rem",
    "font-size-lg": "{fontSize.lg}"
  },
  "control": {
    "$note": "Form controls, segmented controls, menus and copy buttons (.z-input, .z-select, .z-check, .z-switch, .z-segmented, .z-choice, .z-menu, .z-copy in frame.css). Heights are the visual size; on coarse pointers every control grows to target-min (WCAG 2.5.8).",
    "height-sm": "2.25rem",
    "height-md": "2.75rem",
    "height-lg": "3.25rem",
    "target-min": "44px",
    "padding-x": "0.875rem",
    "radius": "{radius.sm}",
    "border-width": "1px",
    "check-size": "1.125rem",
    "switch-width": "2.5rem",
    "switch-height": "1.5rem"
  },
  "motion": {
    "duration-fast": "120ms",
    "duration-base": "200ms",
    "duration-slow": "350ms",
    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)",
    "ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "lift": "1"
  },
  "reducedMotion": {
    "$note": "Emitted under @media (prefers-reduced-motion: reduce).",
    "duration-fast": "0ms",
    "duration-base": "0ms",
    "duration-slow": "0ms",
    "ease-spring": "linear",
    "lift": "0"
  },
  "gradient": {
    "brand": "linear-gradient(135deg, {orange.400} 0%, {plum.600} 100%)"
  }
}
