      "link-hover": "{orange.800}",
      "focus": "{plum.600}",
      "success": "{green.700}",
      "warn": "{amber.700}",
      "danger": "{red.700}",
      "info": "{blue.700}",
      "code-bg": "{neutral.100}",
      "code-fg": "{neutral.900}",
      "code-accent": "{plum.700}",
      "selection-bg": "{orange.200}",
      "selection-fg": "{neutral.900}",
      "button-edge": "{orange.700}",
      "button-2-edge": "{plum.800}",
      "shadow-rgb": "54 18 46"
    }
  },
  "contrast": {
    "$note": "Every pairing below is checked in both themes by build.ts; the build fails if one falls short. text = 4.5:1 (WCAG 1.4.3 AA body), large = 3:1 (AA large text), ui = 3:1 (WCAG 1.4.11 non-text).",
    "both": [
      { "fg": ["text", "heading", "muted", "accent-text", "accent-2-text", "link", "link-hover", "success", "warn", "danger", "info"], "bg": ["bg", "surface", "surface-raised", "code-bg"], "level": "text" },
      { "fg": ["code-fg", "code-accent"], "bg": ["code-bg"], "level": "text" },
      { "fg": ["on-accent"], "bg": ["accent", "accent-hover"], "level": "text" },
      { "fg": ["on-accent-2"], "bg": ["accent-2", "accent-2-hover"], "level": "text" },
      { "fg": ["selection-fg"], "bg": ["selection-bg"], "level": "text" },
      { "fg": ["focus", "border-strong"], "bg": ["bg", "surface", "surface-raised"], "level": "ui" },
      { "fg": ["focus", "border-strong"], "bg": ["code-bg"], "level": "ui", "why": "control boundaries and focus rings on code panels (editors, snippets)" }
    ],
    "dark": [
      { "fg": ["accent", "accent-2"], "bg": ["bg", "surface"], "level": "ui", "why": "button fill is its own boundary on dark" }
    ],
    "light": [
      { "fg": ["button-edge", "button-2-edge"], "bg": ["bg", "surface"], "level": "ui", "why": "orange-400 fill is only 2.2:1 on light, so the raised edge carries the boundary" }
    ]
  },
  "font": {
    "display": "'Unbounded', 'Atkinson Hyperlegible Next', system-ui, sans-serif",
    "text": "'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'Atkinson Hyperlegible Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "fontFace": [
    { "family": "Unbounded", "weight": "200 900", "style": "normal", "files": { "latin": "unbounded-latin-wght-normal.woff2", "latin-ext": "unbounded-latin-ext-wght-normal.woff2" } },
    { "family": "Atkinson Hyperlegible Next", "weight": "200 800", "style": "normal", "files": { "latin": "atkinson-hyperlegible-next-latin-wght-normal.woff2", "latin-ext": "atkinson-hyperlegible-next-latin-ext-wght-normal.woff2" } },
    { "family": "Atkinson Hyperlegible Next", "weight": "200 800", "style": "italic", "files": { "latin": "atkinson-hyperlegible-next-latin-wght-italic.woff2", "latin-ext": "atkinson-hyperlegible-next-latin-ext-wght-italic.woff2" } },
    { "family": "Atkinson Hyperlegible Mono", "weight": "200 800", "style": "normal", "files": { "latin": "atkinson-hyperlegible-mono-latin-wght-normal.woff2", "latin-ext": "atkinson-hyperlegible-mono-latin-ext-wght-normal.woff2" } },
    { "family": "Atkinson Hyperlegible Mono", "weight": "200 800", "style": "italic", "files": { "latin": "atkinson-hyperlegible-mono-latin-wght-italic.woff2", "latin-ext": "atkinson-hyperlegible-mono-latin-ext-wght-italic.woff2" } }
  ],
  "unicodeRange": {
    "latin": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
    "latin-ext": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
  },
